# Normalize to LF in the repository. The CI (Linux) is the reference environment;
# without this, a Windows checkout would produce CRLF diffs and break lint/format parity.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary: never touch. Playwright baselines live here — a single byte of
# line-ending translation would corrupt every visual regression comparison.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles: generated, collapse in diffs
uv.lock linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
