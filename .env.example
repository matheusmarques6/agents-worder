# Supabase CLI publishes the local database and API on the host machine.
# Docker Desktop resolves host.docker.internal automatically; on Linux,
# override these values with the host gateway that your daemon exposes.
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Runtime process wiring.
AGENTS_PROCESS_NAME=agents-runtime-docker
AGENTS_WORKER_SET_ROLE=worker_role
AGENTS_SENDER_SET_ROLE=sender_role

# Leave blank to keep the fixed responder that the runtime already uses today.
AGENTS_RESPONDER=
AGENTS_OPENROUTER_API_KEY=

# Leave blank to keep the sender task disabled.
AGENTS_CHANNEL=
AGENTS_META_ACCESS_TOKEN=
AGENTS_META_API_VERSION=v19.0

# Hub exposure.
HUB_PORT=3000
DESIGN_SHOWCASE=
